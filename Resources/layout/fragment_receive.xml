<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

  <LinearLayout
      android:id="@+id/layout_receive_root"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="12dp">

    <LinearLayout
        android:id="@+id/layout_receive_columns"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

      <LinearLayout
          android:id="@+id/pane_receive_left"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical">

        <!-- Card 1: Sender Info, Save Directory & Pending Confirmation Banner -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:padding="14dp">

            <!-- Row 1: Sender Device + Protocol Badge + Open Folder Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

              <ImageView
                  android:layout_width="18dp"
                  android:layout_height="18dp"
                  android:src="@drawable/ic_download" />

              <TextView
                  android:id="@+id/txt_receive_sender_label"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="6dp"
                  android:text="Sender Device:"
                  android:textStyle="bold"
                  android:textSize="13sp" />

              <TextView
                  android:id="@+id/txt_receive_sender_device"
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:layout_marginStart="6dp"
                  android:text="Waiting for incoming transfers..."
                  android:textStyle="bold"
                  android:textSize="13sp"
                  android:singleLine="true"
                  android:ellipsize="end" />

              <TextView
                  android:id="@+id/badge_receive_protocol"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="6dp"
                  android:background="?attr/colorSecondaryContainer"
                  android:paddingStart="6dp"
                  android:paddingEnd="6dp"
                  android:paddingTop="2dp"
                  android:paddingBottom="2dp"
                  android:fontFamily="monospace"
                  android:text="LocalSend"
                  android:textSize="10sp"
                  android:textStyle="bold"
                  android:textColor="?attr/colorOnSecondaryContainer"
                  android:visibility="gone" />

              <com.google.android.material.button.MaterialButton
                  android:id="@+id/btn_open_receive_folder"
                  style="@style/Widget.Material3.Button.TonalButton"
                  android:layout_width="wrap_content"
                  android:layout_height="36dp"
                  android:layout_marginStart="8dp"
                  android:text="Open Folder"
                  android:textSize="11sp"
                  app:icon="@drawable/ic_folder" />
            </LinearLayout>

            <!-- Row 2: Save Directory -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

              <TextView
                  android:id="@+id/txt_receive_save_dir_label"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Save Directory:"
                  android:textSize="12sp"
                  android:textColor="?attr/colorOnSurfaceVariant" />

              <TextView
                  android:id="@+id/txt_receive_save_dir"
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:layout_marginStart="6dp"
                  android:fontFamily="monospace"
                  android:text="/storage/emulated/0/Download/SyncDroid"
                  android:textSize="12sp"
                  android:textColor="?attr/colorOnSurfaceVariant"
                  android:textIsSelectable="true"
                  android:singleLine="true"
                  android:ellipsize="middle" />
            </LinearLayout>

            <!-- Pending First-Time Confirmation Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_pending_confirm_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorPrimary"
                app:cardBackgroundColor="?attr/colorSurfaceVariant">

              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="vertical"
                  android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                  <ImageView
                      android:layout_width="20dp"
                      android:layout_height="20dp"
                      android:src="@drawable/ic_shield_check" />

                  <TextView
                      android:id="@+id/txt_pending_confirm_banner"
                      android:layout_width="0dp"
                      android:layout_height="wrap_content"
                      android:layout_weight="1"
                      android:layout_marginStart="8dp"
                      android:textStyle="bold"
                      android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                  <com.google.android.material.button.MaterialButton
                      android:id="@+id/btn_accept_transfer_banner"
                      android:layout_width="wrap_content"
                      android:layout_height="36dp"
                      android:text="Accept &amp; Authenticate"
                      android:textSize="12sp" />

                  <com.google.android.material.button.MaterialButton
                      android:id="@+id/btn_decline_transfer_banner"
                      style="?attr/materialButtonOutlinedStyle"
                      android:layout_width="wrap_content"
                      android:layout_height="36dp"
                      android:layout_marginStart="8dp"
                      android:text="Decline"
                      android:textSize="12sp" />
                </LinearLayout>
              </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 2: Incoming Files List -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

              <ImageView
                  android:layout_width="18dp"
                  android:layout_height="18dp"
                  android:src="@drawable/ic_file" />

              <TextView
                  android:id="@+id/txt_receive_files_header"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="6dp"
                  android:text="Incoming Files (File Names)"
                  android:textStyle="bold"
                  android:textSize="13sp" />

              <TextView
                  android:id="@+id/txt_receive_file_count"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="6dp"
                  android:background="?attr/colorSecondaryContainer"
                  android:paddingStart="6dp"
                  android:paddingEnd="6dp"
                  android:paddingTop="1dp"
                  android:paddingBottom="1dp"
                  android:fontFamily="monospace"
                  android:text="0"
                  android:textSize="11sp"
                  android:textStyle="bold"
                  android:textColor="?attr/colorOnSecondaryContainer" />

              <View
                  android:layout_width="0dp"
                  android:layout_height="1dp"
                  android:layout_weight="1" />

              <com.google.android.material.button.MaterialButton
                  android:id="@+id/btn_clear_receive_list"
                  style="@style/Widget.Material3.Button.TextButton"
                  android:layout_width="wrap_content"
                  android:layout_height="34dp"
                  android:text="Clear List"
                  android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_receive_empty_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/colorSurfaceVariant"
                android:gravity="center"
                android:padding="18dp"
                android:text="No incoming files yet."
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_received_files"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                android:scrollbars="vertical" />
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 3: Overall Receive Progress Bar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

              <TextView
                  android:id="@+id/txt_receive_status"
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:text="Ready"
                  android:textStyle="bold"
                  android:textSize="12sp"
                  android:textColor="?attr/colorOnSurfaceVariant" />

              <TextView
                  android:id="@+id/txt_receive_percent"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="6dp"
                  android:background="?attr/colorSecondaryContainer"
                  android:paddingStart="6dp"
                  android:paddingEnd="6dp"
                  android:paddingTop="2dp"
                  android:paddingBottom="2dp"
                  android:fontFamily="monospace"
                  android:text="0%"
                  android:textSize="12sp"
                  android:textStyle="bold"
                  android:textColor="?attr/colorOnSecondaryContainer" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_receive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="0"
                app:trackCornerRadius="4dp"
                app:trackThickness="8dp" />
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
      </LinearLayout>

      <LinearLayout
          android:id="@+id/pane_receive_right"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical">

        <!-- Card 4: Activity Logs -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

              <TextView
                  android:id="@+id/txt_receive_logs_header"
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:text="Activity Logs"
                  android:textStyle="bold"
                  android:textSize="14sp" />

              <com.google.android.material.button.MaterialButton
                  android:id="@+id/btn_receive_clear_logs"
                  style="@style/Widget.Material3.Button.TextButton"
                  android:layout_width="wrap_content"
                  android:layout_height="36dp"
                  android:text="Clear"
                  android:textSize="12sp" />

              <com.google.android.material.button.MaterialButton
                  android:id="@+id/btn_receive_copy_logs"
                  style="@style/Widget.Material3.Button.TonalButton"
                  android:layout_width="wrap_content"
                  android:layout_height="36dp"
                  android:layout_marginStart="4dp"
                  android:text="Copy All"
                  android:textSize="12sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_receive_logs"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="6dp"
                android:background="?attr/colorSurfaceVariant"
                android:padding="6dp"
                android:scrollbars="vertical" />
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
      </LinearLayout>
    </LinearLayout>

  </LinearLayout>
</androidx.core.widget.NestedScrollView>
